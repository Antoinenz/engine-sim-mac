}

public node drivetrain_muscle_car_transmission {
    alias output __out:
        transmission(max_clutch_torque: 600 * units.lb_ft)
        .add_gear(2.20)
        .add_gear(1.64)
        .add_gear(1.28)
        .add_gear(1.00);
}

// Heavy pickup, 4-speed with a granny first gear
public node drivetrain_pickup_truck_vehicle {
    alias output __out:
        vehicle(
            mass: 5000 * units.lb,
            drag_coefficient: 0.45,
            cross_sectional_area: (79 * units.inch) * (72 * units.inch),
            diff_ratio: 4.10,
            tire_radius: 15 * units.inch,
            rolling_resistance: 0.018 * 5000 * units.lb * 9.81
        );
}

public node drivetrain_pickup_truck_transmission {
    alias output __out:
        transmission(max_clutch_torque: 800 * units.lb_ft)
        .add_gear(6.55)
        .add_gear(3.58)
        .add_gear(1.70)
        .add_gear(1.00);
}

// Mid-engine supercar, 7-speed dual clutch
public node drivetrain_supercar_vehicle {
    alias output __out:
        vehicle(
            mass: 3300 * units.lb,
            drag_coefficient: 0.33,
            cross_sectional_area: (76 * units.inch) * (47 * units.inch),
            diff_ratio: 4.44,
            tire_radius: 13.5 * units.inch,
            rolling_resistance: 0.012 * 3300 * units.lb * 9.81
        );
}

public node drivetrain_supercar_transmission {
    alias output __out:
        transmission(max_clutch_torque: 700 * units.lb_ft)
        .add_gear(3.91)
        .add_gear(2.29)
        .add_gear(1.58)
        .add_gear(1.19)
        .add_gear(0.97)
        .add_gear(0.81)
        .add_gear(0.66);
}

// Sport bike with rider; diff ratio is primary x final drive
public node drivetrain_motorcycle_vehicle {
    alias output __out:
        vehicle(
            mass: 700 * units.lb,
            drag_coefficient: 0.6,
            cross_sectional_area: (26 * units.inch) * (45 * units.inch),
            diff_ratio: 3.81,
            tire_radius: 12.5 * units.inch,
            rolling_resistance: 0.015 * 700 * units.lb * 9.81
        );
}

public node drivetrain_motorcycle_transmission {
    alias output __out:
        transmission(max_clutch_torque: 150 * units.lb_ft)
        .add_gear(2.615)
        .add_gear(1.937)
        .add_gear(1.526)
        .add_gear(1.285)
        .add_gear(1.136)
        .add_gear(1.043);
}
