// Vehicle and gearbox presets. Press P in the app to cycle through them.
//
// Each preset is a pair of public nodes named drivetrain_<id>_vehicle and
// drivetrain_<id>_transmission. Add your own by following the same pattern;
// the app picks them up automatically, in the order they appear here.

import "engine_sim.mr"

units units()

// Light front-drive hatchback, 6-speed manual
public node drivetrain_compact_vehicle {
    alias output __out:
        vehicle(
            mass: 2700 * units.lb,
            drag_coefficient: 0.3,
            cross_sectional_area: (72 * units.inch) * (56 * units.inch),
            diff_ratio: 3.9,
            tire_radius: 10 * units.inch,
            rolling_resistance: 0.015 * 2700 * units.lb * 9.81
        );
}

public node drivetrain_compact_transmission {
    alias output __out:
        transmission(max_clutch_torque: 300 * units.lb_ft)
        .add_gear(3.636)
        .add_gear(2.375)
        .add_gear(1.761)
        .add_gear(1.346)
        .add_gear(0.971)
        .add_gear(0.756);
}

// Rear-engine sports car, close-ratio 6-speed manual
public node drivetrain_sports_car_vehicle {
    alias output __out:
        vehicle(
            mass: 3200 * units.lb,
            drag_coefficient: 0.29,
            cross_sectional_area: (71 * units.inch) * (51 * units.inch),
            diff_ratio: 3.44,
            tire_radius: 13 * units.inch,
            rolling_resistance: 0.012 * 3200 * units.lb * 9.81
        );
}

public node drivetrain_sports_car_transmission {
    alias output __out:
        transmission(max_clutch_torque: 500 * units.lb_ft)
        .add_gear(3.82)
        .add_gear(2.20)
        .add_gear(1.52)
        .add_gear(1.22)
        .add_gear(1.02)
        .add_gear(0.84);
}

// 60s/70s muscle car, close-ratio 4-speed
public node drivetrain_muscle_car_vehicle {
    alias output __out:
        vehicle(
            mass: 3600 * units.lb,
            drag_coefficient: 0.45,
            cross_sectional_area: (75 * units.inch) * (53 * units.inch),
            diff_ratio: 3.73,
            tire_radius: 13.5 * units.inch,
            rolling_resistance: 0.015 * 3600 * units.lb * 9.81
